<Window x:Class="MiniFileExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mini File Explorer"
        Height="550"
        Width="950"
        Background="#F3F4F6"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DropShadowEffect x:Key="PanelShadow"
                BlurRadius="8"
                ShadowDepth="1"
                Opacity="0.18"/>
    </Window.Resources>

    <DockPanel>

        <!-- HEADER -->
        <Border DockPanel.Dock="Top"
                Background="#1F2937"
                Padding="12">
            <TextBlock Text="🗂 Mini File Explorer"
                    Foreground="White"
                    FontSize="18"
                    FontWeight="SemiBold"/>
        </Border>

        <!-- SEARCH BAR -->
        <Border DockPanel.Dock="Top"
                Background="#F9FAFB"
                Padding="8,6"
                BorderBrush="#D1D5DB"
                BorderThickness="0,0,0,1">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="🔍"
                        FontSize="14"
                        VerticalAlignment="Center"
                        Margin="6,0"/>
                <TextBox Grid.Column="1"
                        x:Name="txtSearch"
                        Height="32"
                        VerticalContentAlignment="Center"
                         Padding="8,0"
                        FontSize="13"
                        Background="White"
                        BorderBrush="#D1D5DB"
                         BorderThickness="1"
                        TextChanged="SearchTextBox_TextChanged"
                         ToolTip="Search files by name"/>
            </Grid>
        </Border>

        <!-- STATUS BAR -->
        <StatusBar DockPanel.Dock="Bottom"
                Background="#E5E7EB">
            <StatusBarItem>
                <TextBlock Text="{Binding Files.Count, StringFormat=📄 Files: {0}}"
                        Foreground="#374151"/>
            </StatusBarItem>
        </StatusBar>

        <!-- MAIN CONTENT -->
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- TREEVIEW -->
            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="8"
                    Padding="8"
                    Effect="{StaticResource PanelShadow}">
                <TreeView x:Name="TreeViewFolders"
                        ItemsSource="{Binding RootFolders}"
                        SelectedItemChanged="TreeView_SelectedItemChanged"
                        Background="Transparent">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <EventSetter Event="Expanded"
                                    Handler="TreeViewItem_Expanded"/>
                            <Setter Property="Margin"
                                    Value="2"/>
                            <Setter Property="FontSize"
                                    Value="13"/>
                            <Setter Property="Foreground"
                                    Value="#111827"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding SubFolders}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📁"
                                        Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Name}"
                                        Padding="4"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Border>

            <!-- FILE GRID -->
            <Border Grid.Column="2"
                    Background="White"
                    CornerRadius="8"
                    Padding="8"
                    Effect="{StaticResource PanelShadow}">
                <DataGrid x:Name="dgFiles"
                        ItemsSource="{Binding Files}"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                          MouseDoubleClick="DataGrid_MouseDoubleClick"
                        GridLinesVisibility="None"
                        HeadersVisibility="Column"
                          RowBackground="White"
                        AlternatingRowBackground="#F9FAFB"
                        BorderThickness="0"
                        FontSize="13">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="FontWeight"
                                    Value="SemiBold"/>
                            <Setter Property="Background"
                                    Value="#F3F4F6"/>
                            <Setter Property="Foreground"
                                    Value="#374151"/>
                            <Setter Property="Height"
                                    Value="36"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Resources>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Cursor"
                                    Value="Hand"/>
                            <Setter Property="Padding"
                                    Value="4"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver"
                                        Value="True">
                                    <Setter Property="Background"
                                            Value="#E5E7EB"/>
                                </Trigger>
                                <Trigger Property="IsSelected"
                                        Value="True">
                                    <Setter Property="Background"
                                            Value="#D1D5DB"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name"
                                Binding="{Binding Name}"
                                Width="*"/>
                        <DataGridTextColumn Header="Type"
                                Binding="{Binding Type}"
                                Width="90"/>
                        <DataGridTextColumn Header="Size"
                                Binding="{Binding SizeText}"
                                Width="100"/>
                        <DataGridTextColumn Header="Modified"
                                Binding="{Binding Modified}"
                                Width="160"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </DockPanel>
</Window> 
